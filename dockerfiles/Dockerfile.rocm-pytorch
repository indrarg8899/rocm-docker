# ROCm 6.3 + PyTorch
# Multi-stage build for optimized image size
ARG ROCM_VERSION=6.3
ARG UBUNTU_VERSION=22.04

# Stage 1: Base ROCm
FROM rocm/dev-ubuntu-${UBUNTU_VERSION}:${ROCM_VERSION}-complete AS rocm-base

ENV DEBIAN_FRONTEND=noninteractive
ENV ROCM_PATH=/opt/rocm
ENV PATH="${ROCM_PATH}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${ROCM_PATH}/lib"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    wget \
    curl \
    python3 \
    python3-pip \
    python3-dev \
    libsndfile1 \
    libjpeg-dev \
    libpng-dev \
    && rm -rf /var/lib/apt/lists/*

# Stage 2: PyTorch installation
FROM rocm-base AS pytorch-install

ARG TORCH_VERSION=2.3.0
ARG TORCHVISION_VERSION=0.18.0
ARG TORCHAUDIO_VERSION=2.3.0

RUN pip3 install --no-cache-dir \
    torch==${TORCH_VERSION} \
    torchvision==${TORCHVISION_VERSION} \
    torchaudio==${TORCHAUDIO_VERSION} \
    --index-url https://download.pytorch.org/whl/rocm${ROCM_VERSION}

# Stage 3: Runtime with extras
FROM pytorch-install AS runtime

RUN pip3 install --no-cache-dir \
    jupyterlab \
    numpy \
    scipy \
    pandas \
    matplotlib \
    transformers \
    datasets \
    accelerate \
    flash-attn \
    triton

# Create workspace
WORKDIR /workspace
RUN mkdir -p /workspace/notebooks /workspace/data

# Jupyter config
RUN mkdir -p /root/.jupyter && \
    echo "c.ServerApp.ip = '0.0.0.0'" >> /root/.jupyter/jupyter_lab_config.py && \
    echo "c.ServerApp.allow_root = True" >> /root/.jupyter/jupyter_lab_config.py && \
    echo "c.ServerApp.open_browser = False" >> /root/.jupyter/jupyter_lab_config.py

EXPOSE 8888 6006

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD python3 -c "import torch; assert torch.cuda.is_available()" || exit 1

CMD ["jupyter", "lab", "--port=8888", "--no-browser"]
