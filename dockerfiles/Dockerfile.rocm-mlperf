# ROCm 6.3 + MLPerf Training Suite
ARG ROCM_VERSION=6.3
ARG UBUNTU_VERSION=22.04

FROM rocm/dev-ubuntu-${UBUNTU_VERSION}:${ROCM_VERSION}-complete AS base

ENV DEBIAN_FRONTEND=noninteractive
ENV ROCM_PATH=/opt/rocm
ENV PATH="${ROCM_PATH}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${ROCM_PATH}/lib"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    wget \
    curl \
    python3 \
    python3-pip \
    python3-dev \
    numactl \
    hwloc \
    libaio-dev \
    libjemalloc-dev \
    && rm -rf /var/lib/apt/lists/*

# PyTorch + ROCm
RUN pip3 install --no-cache-dir \
    torch torchvision torchaudio \
    --index-url https://download.pytorch.org/whl/rocm${ROCM_VERSION}

# MLPerf dependencies
RUN pip3 install --no-cache-dir \
    mlperf-logging \
    nvidia-ml-py3 \
    scipy \
    scikit-learn \
    pycocotools \
    sacrebleu \
    rouge-score \
    tokenizers \
    sentencepiece \
    boto3 \
    tqdm

# Clone MLPerf Training reference implementations
RUN git clone --depth 1 https://github.com/mlcommons/training.git /opt/mlperf-training

# ResNet-50 deps
RUN pip3 install --no-cache-dir \
    nvidia-dali-cuda120 \
    || pip3 install --no-cache-dir opencv-python-headless

# BERT deps
RUN pip3 install --no-cache-dir \
    torchtext \
    tensorflow-datasets

WORKDIR /opt/mlperf-training

# ROCm-specific patches
ENV HSA_OVERRIDE_GFX_VERSION=11.0.0
ENV HIP_VISIBLE_DEVICES=all
ENV GPU_MAX_HW_QUEUES=8
ENV HSA_ENABLE_SDMA=0

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD python3 -c "import torch; assert torch.cuda.is_available()" || exit 1

CMD ["/bin/bash"]
