# ROCm 6.3 + ONNX Runtime
ARG ROCM_VERSION=6.3
ARG UBUNTU_VERSION=22.04

FROM rocm/dev-ubuntu-${UBUNTU_VERSION}:${ROCM_VERSION}-complete AS base

ENV DEBIAN_FRONTEND=noninteractive
ENV ROCM_PATH=/opt/rocm
ENV PATH="${ROCM_PATH}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${ROCM_PATH}/lib"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    wget \
    curl \
    python3 \
    python3-pip \
    python3-dev \
    protobuf-compiler \
    libprotobuf-dev \
    && rm -rf /var/lib/apt/lists/*

# Install ONNX Runtime with ROCm Execution Provider
ARG ONNXRT_VERSION=1.17.0

RUN pip3 install --no-cache-dir \
    onnxruntime-rocm==${ONNXRT_VERSION} \
    onnx \
    onnxsim \
    numpy \
    protobuf \
    sympy \
    coloredlogs \
    flatbuffers

# ONNX ecosystem tools
RUN pip3 install --no-cache-dir \
    onnx-graphsurgeon \
    polygraphy \
    onnxconverter-common \
    skl2onnx \
    onnxmltools

WORKDIR /workspace
RUN mkdir -p /workspace/models /workspace/data

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD python3 -c "import onnxruntime as ort; print(ort.get_available_providers())" || exit 1

CMD ["python3"]
