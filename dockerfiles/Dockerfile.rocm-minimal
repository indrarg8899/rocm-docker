# Minimal ROCm 6.3 base image
ARG ROCM_VERSION=6.3
ARG UBUNTU_VERSION=22.04

FROM ubuntu:${UBUNTU_VERSION} AS base

ENV DEBIAN_FRONTEND=noninteractive
ENV ROCM_PATH=/opt/rocm
ENV PATH="${ROCM_PATH}/bin:/usr/local/bin:${PATH}"
ENV LD_LIBRARY_PATH="${ROCM_PATH}/lib"

# Install ROCm runtime only (not full SDK)
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    gnupg2 \
    ca-certificates \
    && wget -qO - https://repo.radeon.com/rocm/rocm.gpg.key | apt-key add - \
    && echo "deb [arch=amd64] https://repo.radeon.com/rocm/apt/${ROCM_VERSION} ubuntu main" \
       > /etc/apt/sources.list.d/rocm.list \
    && apt-get update && apt-get install -y --no-install-recommends \
    rocm-hip-runtime \
    rocm-smi-lib \
    hipcc \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Python basics
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir numpy torch --index-url https://download.pytorch.org/whl/rocm6.3

WORKDIR /workspace

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD rocm-smi || exit 1

CMD ["/bin/bash"]
